        </distrib:listOfUncertainties>
      </parameter>
      <parameter sboTerm="SBO:0000002" id="f_OAT3" name="parameter for OAT3 activity" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Activity of the tubular secretion of pravastatin by OAT3 (SLC22A8)
(1.0 reference function, &lt; 1.0 inhibition, e.g. by gemfibrozil). It
scales the secreted part of the renal clearance, PRAEX_f - 1, not the
filtration.</p>
          </body>
        </notes>
      </parameter>
      <parameter id="GFR" name="glomerular filtration rate" units="ml_per_min" constant="false"/>
    </listOfParameters>
    <listOfRules>
      <assignmentRule name="glomerular filtration rate" variable="GFR">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> f_renal_function </ci>
            <ci> GFR_base </ci>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction metaid="meta_PRAEX" sboTerm="SBO:0000655" id="PRAEX" name="excretion pravastatin" reversible="false" compartment="Vki">
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:vCard4="http://www.w3.org/2006/vcard/ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/">
            <rdf:Description rdf:about="#meta_PRAEX">
              <bqbiol:is>
                <rdf:Bag>
                  <rdf:li rdf:resource="https://identifiers.org/ncit:C75913"/>
                </rdf:Bag>
              </bqbiol:is>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
        <listOfReactants>
          <speciesReference species="pra_ext" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="pra_urine" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <times/>
              <ci> GFR </ci>
              <cn sbml:units="l_per_ml"> 0.001 </cn>
              <ci> fu_pra </ci>
              <apply>
                <plus/>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                <apply>
                  <times/>
                  <ci> f_OAT3 </ci>
                  <apply>
                    <minus/>
                    <ci> PRAEX_f </ci>
                    <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                  </apply>
                </apply>
              </apply>
              <ci> pra_ext </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
